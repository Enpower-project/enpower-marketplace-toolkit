# ============================================================
# ENPOWER — Root deployment configuration
# ============================================================
# Copy this file to .env and set your values:
#   cp .env.example .env
#
# This file is read by Docker Compose at startup.
# NEVER commit .env to version control.
# ============================================================

# URL of the server where this stack is deployed.
# Used for email links (password reset, invitations, etc.).
# Format: http://<IP_OR_DOMAIN>:<FRONTEND_PORT>
# Examples:
#   SERVER_URL=http://192.168.1.50:4200
#   SERVER_URL=https://my-server.example.com
SERVER_URL=http://SERVER_IP:4200

# ── Keycloak database ─────────────────────────────────────────────────────────
# Root credentials for the keycloak-db postgres container.
KC_POSTGRES_USER=root
KC_POSTGRES_PASSWORD=password
# Keycloak-specific database, user, and password created inside that postgres.
# Must match the values in marketplace-keycloak/.env.
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=kb1Lmu79hdJKkv4uxbGZ
