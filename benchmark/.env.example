# Credentials for the API latency measurement.
#
# Copy to benchmark/.env and fill in one existing platform account. Without
# credentials the authenticated endpoints are skipped rather than failed, so the
# script still reports the public ones.
#
# benchmark/.env is ignored by git. Do not commit real credentials.

BACKEND_URL=http://localhost:3000

# Must be exactly the KEYCLOAK_AUTH_SERVER_URL in marketplace-be/.env.docker.
# The token records the address it was requested from, and the backend rejects
# tokens issued under any other address, so localhost will not do when the
# backend is configured with the host's IP.
KEYCLOAK_URL=http://localhost:8088
KEYCLOAK_REALM=enpower-marketplace
KEYCLOAK_CLIENT_ID=backend

# The client secret from marketplace-keycloak/imports/enpower-marketplace-realm.json.
# This is the demonstration realm's secret; a real deployment must rotate it.
KEYCLOAK_CLIENT_SECRET=

# An account that already exists in the platform.
API_USERNAME=
API_PASSWORD=

# Calls per endpoint, and untimed calls before measurement begins.
REPEATS=30
WARMUP=3
