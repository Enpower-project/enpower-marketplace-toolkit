# ============================================================
# ENPOWER Smart Contracts — Environment Variables
# ============================================================
# A .env file is only needed when deploying to a remote
# Ethereum node (testnet or production).
# For local development with Docker Compose or Hardhat's
# built-in network, no .env file is required.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================


# ── Local node ──────────────────────────────────────────────
# JSON-RPC URL for the local Hardhat node.
# Default: http://127.0.0.1:8545 (can usually be omitted)
# HARDHAT_RPC_URL=http://127.0.0.1:8545


# ── Remote node ─────────────────────────────────────────────
# Required only for: npm run deploy:remoteNode
# Both variables must be set for the remoteNode network to
# be available in hardhat.config.ts.

REMOTE_RPC_URL=https://your-ethereum-node-rpc-url
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
