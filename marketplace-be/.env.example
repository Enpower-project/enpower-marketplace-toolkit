# ============================================================
# ENPOWER Marketplace Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================


# ── Ethereum / Blockchain ───────────────────────────────────
# Private key of the admin account used to sign smart contract
# transactions. For a local Hardhat node, use one of the
# pre-funded test accounts.
ADMIN_PK=0xYOUR_ETHEREUM_PRIVATE_KEY

# JSON-RPC endpoint of the Ethereum node.
# Docker: http://hardhat:8545
# Local:  http://127.0.0.1:8545
RPC_PROVIDER_URL=http://hardhat:8545


# ── MongoDB ─────────────────────────────────────────────────
# Connection string for the MongoDB database.
MONGO_URI=mongodb://root:password@mongodb:27017/enpower?authSource=admin


# ── Keycloak ────────────────────────────────────────────────
# Authentication is managed by an external Keycloak instance.
# For the ENPOWER research deployment, this is provided by
# COMSENSUS. To reuse this project, deploy your own Keycloak
# instance and create a realm and clients as described in the
# root README.

KEYCLOAK_AUTH_SERVER_URL=http://SERVER_IP:8088
KEYCLOAK_REALM=enpower-marketplace
KEYCLOAK_CLIENT_ID=backend
KEYCLOAK_CLIENT_SECRET=your-backend-client-secret
KEYCLOAK_ISSUER=http://SERVER_IP:8088/realms/enpower-marketplace

# Service account for user management operations (admin-cli or equivalent)
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-client-secret


# ── CORS ────────────────────────────────────────────────────
# URL of the frontend application (used to allow cross-origin requests)
FRONTEND_URL=


# ── Email (SMTP) ────────────────────────────────────────────
# For local development, Mailhog is included in Docker Compose
# and requires no authentication.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Enpower Marketplace


# ── File uploads ────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads


# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log


# ── Smart Contract Addresses ────────────────────────────────
# These are populated automatically by Docker Compose when the
# hardhat service deploys the contracts on startup.
# For local development outside Docker, copy the addresses
# from flexibility-market-smartcontracts/deployments/ after
# running: npm run deploy:localhost
FLEXIBILITY_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
FLEXIBILITY_NFT_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
